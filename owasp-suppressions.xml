<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd
                                  https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!-- FALSE POSITIVE (triaged 2026-11-26, dependency-check 12.1.0):
         dependency-check's filename heuristic CPE-matched the generic marker
         "classes.jar" (empty jar, sha1 b04f3ee8f5e43fa3b162981b50bb72fe1acabb33,
         present inside several AndroidX aars such as
         androidx.core:core-viewtree@1.0.0 and androidx.lifecycle:lifecycle-viewmodel)
         to Apache Impala / ZooKeeper CPEs. This Android app ships none of that
         server software; the CVEs are unreachable from any dependency here.
         Suppressed per packageUrl + CVE so the rule is narrow and auditable. -->
    <suppress>
        <notes><![CDATA[Apache ZooKeeper authorization bypass - matched to lifecycle-viewmodel's empty marker classes.jar; app ships no ZooKeeper.]]></notes>
        <packageUrl regex="true">pkg:maven/androidx\.lifecycle/lifecycle-viewmodel@.*</packageUrl>
        <cve>CVE-2023-44981</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[Apache Impala RENAME privilege issue - matched to lifecycle-viewmodel's empty marker classes.jar; app ships no Impala.]]></notes>
        <packageUrl regex="true">pkg:maven/androidx\.lifecycle/lifecycle-viewmodel@.*</packageUrl>
        <cve>CVE-2018-11792</cve>
    </suppress>
    <!-- CVE-2026-53914 affects JetBrains Kotlin BEFORE 2.4.20. The shipped
         kotlin-stdlib is 2.4.21 (patched, pinned in gradle/libs.versions.toml
         kotlin=2.4.21). The CPE matcher (cpe:/a:jetbrains:kotlin) ignores the
         vulnerable-version range, so suppress for the stdlib package; KEEP
         kotlin=2.4.21 or newer in libs.versions.toml or remove this rule. -->
    <suppress>
        <notes><![CDATA[CVE range is Kotlin < 2.4.20; shipped stdlib is 2.4.21 (patched). Keep libs.versions.toml kotlin >= 2.4.20 or remove this rule.]]></notes>
        <packageUrl regex="true">pkg:maven/org\.jetbrains\.kotlin/kotlin-stdlib@.*</packageUrl>
        <cve>CVE-2026-53914</cve>
    </suppress>
</suppressions>
