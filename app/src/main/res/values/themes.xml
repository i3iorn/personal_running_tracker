<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PersonalRunningTracker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/rt_primary</item>
        <item name="colorPrimaryVariant">@color/rt_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorOnBackground">@color/rt_on_surface</item>
        <item name="colorSurface">@color/rt_surface</item>
        <item name="colorOnSurface">@color/rt_on_surface</item>
        <item name="android:statusBarColor">@color/rt_primary_dark</item>
        <item name="android:windowBackground">@color/rt_background</item>
    </style>

    <style name="SettingsLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@color/rt_on_surface_variant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsControl">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
</resources>
